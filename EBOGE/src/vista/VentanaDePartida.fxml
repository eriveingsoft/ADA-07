<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<AnchorPane fx:id="panelFondo" id="panelFondo"
    stylesheets="@Partida.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controlador.ControladorVentanaDePartida">

    <children>
		<Label fx:id="lblMensajeEstado"
               text="¡La partida ha comenzado!"
               alignment="CENTER"
               mouseTransparent="true"
               AnchorPane.topAnchor="10.0"
               AnchorPane.leftAnchor="100.0"
               AnchorPane.rightAnchor="380.0" />

        <!-- Botones de control superior: Reiniciar y Salir al Menú (CR-01 / CR-02) -->
        <HBox spacing="10" alignment="CENTER_RIGHT"
              AnchorPane.topAnchor="10.0"
              AnchorPane.rightAnchor="20.0">
            <children>
                <Button fx:id="btnReiniciar"
                        text="Reiniciar Partida"
                        styleClass="btn-reiniciar"
                        prefHeight="36" prefWidth="160" />
                <Button fx:id="btnSalirMenu"
                        text="Salir al Menú"
                        styleClass="btn-salir-menu"
                        prefHeight="36" prefWidth="140" />
            </children>
        </HBox>
               
        <!-- TABLERO -->
        <GridPane fx:id="gridTablero"
                  AnchorPane.topAnchor="65.0"
                  AnchorPane.leftAnchor="40.0"
                  AnchorPane.rightAnchor="40.0"
                  AnchorPane.bottomAnchor="255.0" />

        <!-- BARRA INFERIOR -->
        <HBox fx:id="barraInferior" spacing="15" alignment="CENTER"
              AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0"
              AnchorPane.bottomAnchor="43.0">

            <children>

                <!-- Mazos -->
                <Button fx:id="btnAbrirMazoPropio" styleClass="mazo-propio"
                        prefWidth="160" prefHeight="200" />

                <Button fx:id="btnAbrirMazoObjetivo" styleClass="mazo-target"
                        prefWidth="160" prefHeight="200" />

                <Button fx:id="btnAbrirMazoGlobal" styleClass="mazo-global"
                        prefWidth="160" prefHeight="200" />

                <Button fx:id="btnAbrirMazoMaestro" styleClass="mazo-maestro"
                        prefWidth="160" prefHeight="200" />

                <!-- separador flexible -->
                <Pane HBox.hgrow="ALWAYS" />

                <!-- Bloque CENTRADO: Turno de / Nombre -->
                <VBox alignment="CENTER" spacing="6">
                    <children>
                        <Label fx:id="lblTurnoTexto" text="Turno de:" styleClass="turno-texto" />
                        <Label fx:id="lblNombreJugador" text="Jugador" styleClass="turno-nombre" />
                    </children>
                </VBox>

                <!-- separador flexible -->
                <Pane HBox.hgrow="ALWAYS" />

                <!-- Bloque resultado + botón dado -->
                <VBox alignment="CENTER" spacing="10">
                    <children>
                        <Label fx:id="lblResultadoDado" text="-" styleClass="resultado-dado" />
                        <Button fx:id="btnLanzarDado" text="Dado"
                                styleClass="boton-dado"
                                prefWidth="240" prefHeight="140" />
                    </children>
                </VBox>

            </children>
        </HBox>


        <!-- ========================================================= -->
        <!-- 🔥 OVERLAY DE CARTA EN GRANDE (NUEVO)                    -->
        <!-- ========================================================= -->
        <StackPane fx:id="overlayCarta"
                   visible="false" managed="false"
                   style="-fx-background-color: rgba(0,0,0,0.65);"
                   AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
                   AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

            <children>

                <!-- Botón que muestra la carta grande -->
                <Button fx:id="btnCartaGrande"
                        prefWidth="600" prefHeight="850"
                        style="-fx-background-color: transparent;
                               -fx-background-size: contain;
                               -fx-background-position: center;
                               -fx-background-repeat: no-repeat;" />

            </children>

        </StackPane>

        <!-- ========================================================= -->
        <!-- 🏆 OVERLAY DE VICTORIA Y REINICIO                        -->
        <!-- ========================================================= -->
        <StackPane fx:id="overlayVictoria"
                   visible="false" managed="false"
                   style="-fx-background-color: rgba(0,0,0,0.68);"
                   AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
                   AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

            <children>
                <VBox alignment="CENTER" spacing="24"
                      maxWidth="-Infinity" maxHeight="-Infinity"
                      styleClass="panel-victoria">
                    <children>
                        <ImageView fitWidth="180" fitHeight="180" preserveRatio="true"
                                   style="-fx-effect: dropshadow(gaussian, rgba(255,215,0,0.85), 25, 0.5, 0, 0);">
                            <image>
                                <Image url="@/imagenes/CasillaFinal.png" />
                            </image>
                        </ImageView>
                        <Label fx:id="lblVictoriaMensaje"
                               text="¡VICTORIA!"
                               alignment="CENTER"
                               textAlignment="CENTER"
                               styleClass="victoria-titulo" />
                        <HBox spacing="20" alignment="CENTER">
                            <children>
                                <Button fx:id="btnReiniciarOverlay"
                                        text="Reiniciar Partida"
                                        styleClass="btn-reiniciar-grande"
                                        prefWidth="220" prefHeight="55" />
                                <Button fx:id="btnSalirMenuOverlay"
                                        text="Salir al Menú"
                                        styleClass="btn-salir-grande"
                                        prefWidth="200" prefHeight="55" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>

    </children>
</AnchorPane>
